<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>WhatsApp Video Call</title>

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: Arial, sans-serif;
        }

        body {
            height: 100vh;
            background: #111b21;
            display: flex;
            justify-content: center;
            align-items: center;
        }

        .video-call {
            width: 400px;
            height: 650px;
            background: #202c33;
            position: relative;
            overflow: hidden;
            color: white;
        }

        .remote-video {
            width: 100%;
            height: 100%;
            background: linear-gradient(
                135deg,
                #37474f,
                #263238
            );
            display: flex;
            justify-content: center;
            align-items: center;
        }

        .remote-profile {
            width: 130px;
            height: 130px;
            border-radius: 50%;
            background: #ddd;
            display: flex;
            justify-content: center;
            align-items: center;
            font-size: 60px;
            color: #666;
        }

        .top-bar {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            padding: 18px;
            display: flex;
            align-items: center;
            background: linear-gradient(
                rgba(0,0,0,0.6),
                transparent
            );
            z-index: 5;
        }

        .back {
            font-size: 30px;
            cursor: pointer;
            margin-right: 15px;
        }

        .user-info {
            display: flex;
            flex-direction: column;
        }

        .user-name {
            font-size: 18px;
            font-weight: bold;
        }

        .call-status {
            font-size: 13px;
            margin-top: 3px;
            color: #ddd;
        }

        .timer {
            font-size: 13px;
            margin-top: 2px;
            color: #ddd;
        }

        .my-video {
            position: absolute;
            right: 15px;
            top: 75px;
            width: 105px;
            height: 145px;
            background: #455a64;
            border-radius: 8px;
            border: 2px solid white;
            display: flex;
            justify-content: center;
            align-items: center;
            z-index: 4;
            overflow: hidden;
        }

        .camera-icon {
            font-size: 35px;
        }

        .camera-off {
            display: none;
        }

        .controls {
            position: absolute;
            bottom: 25px;
            left: 0;
            width: 100%;
            display: flex;
            justify-content: center;
            gap: 15px;
            z-index: 5;
        }

        .control {
            width: 52px;
            height: 52px;
            border: none;
            border-radius: 50%;
            background: rgba(255,255,255,0.2);
            color: white;
            font-size: 21px;
            cursor: pointer;
        }

        .control:hover {
            background: rgba(255,255,255,0.35);
        }

        .control.active {
            background: white;
            color: #111;
        }

        .end-call {
            width: 62px;
            height: 62px;
            background: #ea0038;
            font-size: 25px;
        }

        .end-call:hover {
            background: #c90030;
        }

        .message {
            position: absolute;
            bottom: 100px;
            left: 0;
            width: 100%;
            text-align: center;
            font-size: 13px;
            color: #ddd;
            z-index: 5;
        }

        @media (max-width: 500px) {
            .video-call {
                width: 100%;
                height: 100vh;
            }
        }
    </style>
</head>

<body>

    <div class="video-call">

        <!-- Remote video -->
        <div class="remote-video">

            <div class="remote-profile">
                👤
            </div>

        </div>

        <!-- Top information -->
        <div class="top-bar">

            <div class="back" onclick="goBack()">
                ‹
            </div>

            <div class="user-info">

                <div class="user-name">
                    John
                </div>

                <div class="call-status" id="callStatus">
                    Calling...
                </div>

                <div class="timer" id="timer">
                    00:00
                </div>

            </div>

        </div>

        <!-- Your camera preview -->
        <div class="my-video" id="myVideo">

            <div class="camera-icon" id="cameraIcon">
                📹
            </div>

            <div class="camera-off" id="cameraOff">
                📷
            </div>

        </div>

        <!-- Status message -->
        <div class="message" id="message">
            Calling John...
        </div>

        <!-- Controls -->
        <div class="controls">

            <button
                class="control"
                id="muteButton"
                onclick="toggleMute()">
                🎙️
            </button>

            <button
                class="control"
                id="cameraButton"
                onclick="toggleCamera()">
                📹
            </button>

            <button
                class="control"
                id="speakerButton"
                onclick="toggleSpeaker()">
                🔊
            </button>

            <button
                class="control end-call"
                onclick="endCall()">
                ☎
            </button>

        </div>

    </div>


    <script>

        let seconds = 0;
        let timerInterval;
        let connected = false;

        const timer = document.getElementById("timer");
        const callStatus = document.getElementById("callStatus");
        const message = document.getElementById("message");

        /*
            Start the simulated video call
        */

        function startCall() {

            setTimeout(function() {

                connected = true;

                callStatus.innerText = "Connected";
                message.innerText = "Video call in progress";

                timerInterval = setInterval(function() {

                    seconds++;

                    let minutes =
                        Math.floor(seconds / 60);

                    let remainingSeconds =
                        seconds % 60;

                    minutes =
                        minutes < 10
                        ? "0" + minutes
                        : minutes;

                    remainingSeconds =
                        remainingSeconds < 10
                        ? "0" + remainingSeconds
                        : remainingSeconds;

                    timer.innerText =
                        minutes + ":" +
                        remainingSeconds;

                }, 1000);

            }, 2000);
        }


        /*
            Mute microphone
        */

        function toggleMute() {

            const button =
                document.getElementById("muteButton");

            if (button.classList.contains("active")) {

                button.classList.remove("active");

                button.innerText = "🎙️";

                message.innerText =
                    "Microphone on";

            } else {

                button.classList.add("active");

                button.innerText = "🔇";

                message.innerText =
                    "Microphone muted";
            }
        }


        /*
            Turn camera on/off
        */

        function toggleCamera() {

            const button =
                document.getElementById("cameraButton");

            const cameraIcon =
                document.getElementById("cameraIcon");

            const cameraOff =
                document.getElementById("cameraOff");

            if (button.classList.contains("active")) {

                button.classList.remove("active");

                cameraIcon.style.display = "block";

                cameraOff.style.display = "none";

                message.innerText =
                    "Camera turned on";

            } else {

                button.classList.add("active");

                cameraIcon.style.display = "none";

                cameraOff.style.display = "block";

                message.innerText =
                    "Camera turned off";
            }
        }


        /*
            Speaker
        */

        function toggleSpeaker() {

            const button =
                document.getElementById("speakerButton");

            if (button.classList.contains("active")) {

                button.classList.remove("active");

                button.innerText = "🔊";

                message.innerText =
                    "Speaker off";

            } else {

                button.classList.add("active");

                button.innerText = "🔊";

                message.innerText =
                    "Speaker on";
            }
        }


        /*
            End video call
        */

        function endCall() {

            clearInterval(timerInterval);

            connected = false;

            callStatus.innerText =
                "Call ended";

            message.innerText =
                "Video call ended";

            document.querySelector(".end-call")
                .style.background = "#555";

        }


        /*
            Back button
        */

        function goBack() {

            alert("Returning to chat...");

        }


        /*
            Start call
        */

        startCall();

    </script>

</body>
</html>
